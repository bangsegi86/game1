{
  "name": "shell-clash-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "포탄대결 서버 (친구용 로컬 서버)",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "build:mockup": "esbuild ../mockup/practice.js --bundle --format=iife --outfile=../mockup/practice.bundle.js --log-level=warning"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "socket.io-client": "^4.8.1"
  }
}